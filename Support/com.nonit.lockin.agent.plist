<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.nonit.lockin.agent</string>
	<key>BundleProgram</key><string>Contents/MacOS/LockIn</string>
	<key>AssociatedBundleIdentifiers</key><array><string>com.nonit.lockin</string></array>
	<key>RunAtLoad</key><true/>
	<!-- Relaunch after a crash, but respect Quit (exit 0). -->
	<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
	<key>LimitLoadToSessionType</key><string>Aqua</string>
	<key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
